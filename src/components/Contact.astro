---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
---

<section id="contacts" class="py-16 lg:py-24 bg-white">
  <div class="container-premium">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-12 items-start">
      <!-- Form -->
      <div class="rounded-[28px] bg-navy-900 text-white p-6 lg:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-accent-500/20 blur-[60px]"></div>
        <div class="relative">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-bold tracking-wide uppercase">{t('contact.eyebrow')}</div>
          <h2 class="mt-3 font-display font-extrabold text-[28px] lg:text-[36px] leading-[0.95]">{t('contact.title')}</h2>
          <p class="mt-3 text-white/70">{t('contact.subtitle')}</p>

          <form class="mt-8 grid gap-4" id="contact-form" novalidate data-contact-form>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <!-- CSRF token placeholder (would be generated server-side) -->
            <input type="hidden" name="csrf" value="static-csrf-placeholder" />

            <label class="grid gap-1.5">
              <span class="text-xs font-semibold tracking-wide uppercase text-white/80">{t('contact.form.name')}</span>
              <input name="name" autocomplete="name" placeholder={lang==='ru' ? 'Как к вам обращаться' : 'Your name'} class="w-full rounded-xl border border-white/15 bg-white/10 backdrop-blur px-4 py-3 text-sm placeholder:text-white/50 focus:bg-white focus:text-navy-900 focus:placeholder:text-ink-500 focus:outline-none" />
            </label>

            <label class="grid gap-1.5">
              <span class="text-xs font-semibold tracking-wide uppercase text-white/80">{t('contact.form.phone')} <span class="text-accent-400">*</span></span>
              <input required type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+7 900 000-00-00" class="w-full rounded-xl border border-white/15 bg-white/10 backdrop-blur px-4 py-3 text-sm placeholder:text-white/50 focus:bg-white focus:text-navy-900 focus:outline-none" />
              <span class="hidden text-xs text-red-300" data-err-phone>{lang==='ru' ? 'Укажите корректный телефон' : 'Enter valid phone'}</span>
            </label>

            <label class="grid gap-1.5">
              <span class="text-xs font-semibold tracking-wide uppercase text-white/80">{t('contact.form.cargo')}</span>
              <textarea name="cargo" rows="3" placeholder={lang==='ru' ? 'Напр.: 320 кг текстиль, Гуанчжоу → Пятигорск' : 'e.g. 320 kg textile, Guangzhou → Pyatigorsk'} class="w-full rounded-xl border border-white/15 bg-white/10 backdrop-blur px-4 py-3 text-sm placeholder:text-white/50 focus:bg-white focus:text-navy-900 focus:outline-none resize-none"></textarea>
            </label>

            <label class="flex items-start gap-3 text-xs leading-relaxed text-white/80">
              <input type="checkbox" name="privacy" required class="mt-0.5 size-4 rounded border-white/30 bg-white/10 accent-accent-500" />
              <span>{t('contact.form.privacy')} <a href="#privacy" class="underline hover:text-white">{lang==='ru' ? 'политикой' : 'policy'}</a> <span class="text-red-300">*</span></span>
            </label>

            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-4 shadow-lg shadow-accent-500/20 transition-colors disabled:opacity-60">
              <span data-label>{t('contact.form.submit')}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4L12 14.1l-3-3"/></svg>
            </button>

            <p class="hidden rounded-xl bg-emerald-500 text-white text-sm px-4 py-3 font-medium" data-success role="status">{t('contact.form.success')}</p>
            <p class="hidden rounded-xl bg-red-500 text-white text-sm px-4 py-3" data-error role="alert"></p>

            <p class="text-center text-[11px] leading-relaxed text-white/50">
              {lang==='ru' ? 'Защита от спама: reCAPTCHA • Данные шифруются (TLS). Не передаём третьим лицам.' : 'Spam protection: reCAPTCHA • TLS encrypted. No third-party sharing.'}
            </p>
          </form>
        </div>
      </div>

      <!-- Info -->
      <div class="lg:sticky lg:top-28 grid gap-6">
        <div>
          <h3 class="font-display font-extrabold text-[24px] text-navy-900">{lang==='ru' ? 'На связи — отвечаем быстро' : 'Get in touch — fast reply'}</h3>
          <p class="mt-2 text-ink-700">{lang==='ru' ? 'Звоните, пишите в мессенджеры или приезжайте на склад. Покажем как храним и везём.' : 'Call, message or visit warehouse. We’ll show how we store & ship.'}</p>
        </div>

        <div class="grid gap-4">
          <div class="rounded-2xl bg-surface-50 border border-line-200 p-5 flex gap-4">
            <span class="grid size-10 place-items-center rounded-xl bg-navy-900 text-white shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div>
              <div class="text-xs font-bold tracking-wide uppercase text-ink-500">{t('contact.info.address_title')}</div>
              <div class="mt-1 text-sm font-medium text-navy-900">{t('contact.info.address')}</div>
              <a href="https://yandex.ru/maps/?text=Минеральные%20Воды%20Советская%2032" target="_blank" rel="noopener" class="mt-2 inline-flex text-sm font-semibold text-accent-600 hover:text-accent-700">{lang==='ru' ? 'Построить маршрут →' : 'Get directions →'}</a>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="rounded-2xl bg-surface-50 border border-line-200 p-5">
              <div class="text-xs font-bold tracking-wide uppercase text-ink-500">{t('contact.info.phone_title')}</div>
              <a href="tel:+79650693173" class="mt-1 block font-display font-extrabold text-lg text-navy-900 hover:text-accent-600 transition-colors">+7 965 069-31-73</a>
              <div class="mt-2 flex gap-2">
                <a href="https://wa.me/79650693173?text=Здравствуйте%2C%20нужен%20расчёт%20доставки%20из%20Китая" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-[#25D366] text-white text-xs font-bold px-3 py-1.5">WhatsApp</a>
                <a href="https://t.me/cargo819" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-[#229ED9] text-white text-xs font-bold px-3 py-1.5">Telegram</a>
              </div>
            </div>
            <div class="rounded-2xl bg-surface-50 border border-line-200 p-5">
              <div class="text-xs font-bold tracking-wide uppercase text-ink-500">{t('contact.info.email_title')}</div>
              <a href="mailto:info@cargo819.ru" class="mt-1 block font-semibold text-navy-900">info@cargo819.ru</a>
              <div class="mt-3 text-xs font-bold tracking-wide uppercase text-ink-500">{t('contact.info.hours_title')}</div>
              <div class="text-sm text-ink-700 leading-tight">{t('contact.info.hours')}</div>
            </div>
          </div>

          <!-- Map placeholder (static image to avoid heavy iframe, but iframe on demand) -->
          <div class="rounded-[20px] overflow-hidden border border-line-200 bg-surface-50">
            <div class="aspect-[16/10] relative">
              <img src="/images/blog-1.jpg" alt="Склад" width="640" height="400" class="w-full h-full object-cover" loading="lazy" decoding="async" />
              <div class="absolute inset-0 bg-navy-900/10"></div>
              <button type="button" class="absolute inset-0 grid place-items-center group" data-load-map aria-label={lang==='ru' ? 'Загрузить карту' : 'Load map'}>
                <span class="inline-flex items-center gap-2 rounded-full bg-white shadow-xl px-5 py-3 font-bold text-navy-900 group-hover:scale-105 transition-transform">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 4v12l-7 4-7-4V6z"/><path d="M12 22V6"/><path d="M12 6L5 2"/><path d="M19 6L12 2"/></svg>
                  {lang==='ru' ? 'Показать карту' : 'Show map'}
                </span>
              </button>
              <iframe data-map-frame class="hidden absolute inset-0 w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Yandex Map — Mineralnye Vody"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Contact form with OWASP-aware handling (client side only demo — real validation server-side with Zod)
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
  if (form) {
    const phone = form.querySelector('input[name="phone"]') as HTMLInputElement;
    const errPhone = form.querySelector('[data-err-phone]') as HTMLElement;
    const success = form.querySelector('[data-success]') as HTMLElement;
    const error = form.querySelector('[data-error]') as HTMLElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = form.querySelector('[data-label]') as HTMLElement;

    const validPhone = (v: string) => v.replace(/\D/g,'').length >= 10 && v.replace(/\D/g,'').length <= 15;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.add('hidden'); success.classList.add('hidden');

      const hp = (form.querySelector('input[name="website"]') as HTMLInputElement)?.value;
      if (hp) return;

      const last = Number(localStorage.getItem('cargo819_contact_last') || 0);
      if (Date.now() - last < 30000) {
        error.textContent = document.documentElement.lang==='en' ? 'Please wait 30s before next request.' : 'Подождите 30 секунд.';
        error.classList.remove('hidden'); return;
      }

      let ok = true;
      if (!phone || !validPhone(phone.value)) {
        ok=false; phone?.classList.add('border-red-400'); errPhone?.classList.remove('hidden');
      } else { phone?.classList.remove('border-red-400'); errPhone?.classList.add('hidden'); }

      const privacy = form.querySelector('input[name="privacy"]') as HTMLInputElement;
      if (!privacy?.checked) { ok=false; privacy?.classList.add('outline','outline-red-400'); error.textContent = document.documentElement.lang==='en' ? 'Agree to privacy policy.' : 'Согласитесь с политикой.'; error.classList.remove('hidden'); return; }

      if (!ok) {
        error.textContent = document.documentElement.lang==='en' ? 'Check highlighted fields.' : 'Проверьте подсвеченные поля.';
        error.classList.remove('hidden'); return;
      }

      const orig = label.textContent;
      btn.disabled = true;
      label.textContent = document.documentElement.lang==='en' ? 'Sending...' : 'Отправляем...';
      await new Promise(r=>setTimeout(r, 900));
      localStorage.setItem('cargo819_contact_last', String(Date.now()));
      form.reset();
      success.classList.remove('hidden');
      btn.disabled=false;
      if (orig) label.textContent=orig;
      try { (window as any).gtag?.('event','generate_lead',{source:'contact'});} catch {}
    });
  }

  // Lazy map
  const btnLoad = document.querySelector('[data-load-map]') as HTMLButtonElement | null;
  const frame = document.querySelector('[data-map-frame]') as HTMLIFrameElement | null;
  btnLoad?.addEventListener('click', () => {
    if (!frame) return;
    frame.src = 'https://yandex.ru/map-widget/v1/?um=constructor%3A1a2b3c&source=constructor&text=Минеральные%20Воды%20Советская%2032';
    frame.classList.remove('hidden');
    btnLoad.classList.add('hidden');
  });
</script>
