---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
---

<section id="process" class="py-16 lg:py-24 bg-white">
  <div class="container-premium">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-surface-50 border border-line-200 px-3 py-1 text-xs font-bold tracking-wide uppercase text-navy-900">{t('process.eyebrow')}</div>
      <h2 class="mt-3 font-display font-extrabold text-[30px] lg:text-[44px] leading-[0.95] text-navy-900">{t('process.title')}</h2>
      <p class="mt-3 text-ink-700">{t('process.subtitle')}</p>
    </div>

    <div class="mt-12 grid lg:grid-cols-4 gap-6">
      {[0,1,2,3].map(i => (
        <div class="relative rounded-[24px] bg-white border border-line-200 p-6 lg:p-7 hover:shadow-xl hover:shadow-navy-900/5 transition-all">
          <div class="flex items-center justify-between">
            <span class="grid size-10 place-items-center rounded-full bg-navy-900 text-white font-extrabold">0{i+1}</span>
            <span class="hidden lg:block h-px flex-1 ml-4 bg-line-200"></span>
          </div>
          <h3 class="mt-4 font-display font-bold text-[16px] leading-tight text-navy-900">{t(`process.steps.${i}.title` as any)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{t(`process.steps.${i}.desc` as any)}</p>
          {i===1 && <img src="/images/project-2.jpg" alt="" width="400" height="220" class="mt-4 w-full h-28 object-cover rounded-xl border border-line-200" loading="lazy" decoding="async" />}
          {i===2 && <img src="/images/project-3.jpg" alt="" width="400" height="220" class="mt-4 w-full h-28 object-cover rounded-xl border border-line-200" loading="lazy" decoding="async" />}
        </div>
      ))}
    </div>

    <div class="mt-8 grid lg:grid-cols-[1.2fr_0.8fr] gap-6">
      <div class="rounded-[24px] bg-emerald-50 border border-emerald-200 p-6 flex gap-4">
        <span class="grid size-10 place-items-center rounded-full bg-emerald-600 text-white shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <div>
          <div class="font-semibold text-emerald-900">{lang==='ru' ? 'Гарантия срока' : 'Deadline guarantee'}</div>
          <div class="text-sm text-emerald-800 mt-1">{t('process.guarantee')}</div>
        </div>
      </div>
      <a href="#contacts" class="rounded-[24px] bg-navy-900 text-white p-6 flex items-center justify-between hover:bg-navy-800 transition-colors group">
        <div>
          <div class="font-bold">{t('process.cta')}</div>
          <div class="text-sm text-white/70">{lang==='ru' ? 'Ответим за 15 минут' : 'Reply in 15 min'}</div>
        </div>
        <span class="grid size-10 place-items-center rounded-full bg-white text-navy-900 group-hover:translate-x-1 transition-transform"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg></span>
      </a>
    </div>
  </div>
</section>
