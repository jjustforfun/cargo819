---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
---

<section id="geo" class="py-16 lg:py-24 bg-navy-900 text-white relative overflow-hidden">
  <!-- decor -->
  <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>
  <div class="absolute -top-24 -right-24 w-[520px] h-[520px] rounded-full bg-accent-500/20 blur-[80px]"></div>
  <div class="absolute -bottom-24 -left-24 w-[520px] h-[520px] rounded-full bg-white/5 blur-[80px]"></div>

  <div class="relative container-premium grid lg:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-bold tracking-wide uppercase">
        <span class="size-1.5 rounded-full bg-accent-500"></span>{t('geo.eyebrow')}
      </div>
      <h2 class="mt-4 font-display font-extrabold text-[30px] lg:text-[42px] leading-[0.95] text-balance">{t('geo.title')}</h2>
      <p class="mt-4 text-white/75 leading-relaxed">{t('geo.text')}</p>

      <div class="mt-6 inline-flex flex-wrap gap-2 text-xs font-semibold">
        { (t('geo.cities') as string).split('•').map(c => (
          <span class="rounded-full bg-white/10 border border-white/15 px-3 py-1.5">{c.trim()}</span>
        ))}
      </div>

      <ul class="mt-8 grid gap-3">
        {[0,1,2].map(i => (
          <li class="flex items-center gap-3 rounded-2xl bg-white/10 border border-white/10 px-4 py-3 backdrop-blur">
            <span class="grid size-8 place-items-center rounded-full bg-emerald-500 text-white shrink-0"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></span>
            <span class="text-sm">{t(`geo.bullets.${i}` as any)}</span>
          </li>
        ))}
      </ul>

      <a href="#contacts" class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 py-3 shadow-lg shadow-accent-500/20 transition-colors">
        {t('geo.cta')} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Map card -->
    <div class="relative">
      <div class="rounded-[28px] overflow-hidden bg-white text-navy-900 shadow-2xl border border-white/10">
        <div class="aspect-[4/3] relative bg-surface-50">
          <img src="/images/bg-6.jpg" alt={lang==='ru' ? 'Карта КМВ — покрытие' : 'KMV coverage map'} width="640" height="480" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 to-transparent"></div>
          <!-- Pins -->
          <div class="absolute top-[42%] left-[38%] grid place-items-center">
            <span class="size-3 rounded-full bg-accent-500 shadow-[0_0_0_8px_rgba(255,106,0,0.25)] animate-pulse"></span>
            <span class="mt-1 rounded-full bg-white px-2 py-1 text-[11px] font-bold shadow">Мин-Воды • склад</span>
          </div>
          <div class="absolute top-[48%] left-[52%] grid place-items-center">
            <span class="size-2.5 rounded-full bg-white border-2 border-navy-900"></span>
            <span class="mt-1 rounded-full bg-navy-900 text-white px-2 py-1 text-[11px] font-bold">Пятигорск</span>
          </div>
          <div class="absolute top-[58%] left-[46%] grid place-items-center">
            <span class="size-2.5 rounded-full bg-white border-2 border-navy-900"></span>
            <span class="mt-1 rounded-full bg-navy-900 text-white px-2 py-1 text-[11px] font-bold">Кисловодск</span>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center justify-between">
            <div class="font-display font-bold">Минеральные Воды • Советская 32</div>
            <span class="text-xs font-bold tracking-wide uppercase bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1 rounded-full">Склад • Офис</span>
          </div>
          <div class="mt-2 text-sm text-ink-500">Пн–Сб 9:00–19:00 • Самовывоз и доставка по КМВ 1–2 дня</div>
          <div class="mt-4 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl bg-surface-50 border border-line-200 p-3">
              <div class="font-extrabold text-navy-900">1–2</div>
              <div class="text-[11px] text-ink-500 leading-tight">дня до двери по КМВ</div>
            </div>
            <div class="rounded-xl bg-surface-50 border border-line-200 p-3">
              <div class="font-extrabold text-navy-900">500кг+</div>
              <div class="text-[11px] text-ink-500 leading-tight">бесплатно по КМВ</div>
            </div>
            <div class="rounded-xl bg-surface-50 border border-line-200 p-3">
              <div class="font-extrabold text-navy-900">20т</div>
              <div class="text-[11px] text-ink-500 leading-tight">ежедневно фуры</div>
            </div>
          </div>
          <a href="https://yandex.ru/maps/?text=Минеральные%20Воды%20Советская%2032" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex w-full justify-center items-center gap-2 rounded-full border border-line-200 bg-white hover:bg-surface-50 px-4 py-3 font-semibold text-navy-900 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg>
            {lang==='ru' ? 'Открыть в картах' : 'Open in maps'}
          </a>
        </div>
      </div>
      <!-- small floating badge -->
      <div class="hidden lg:flex absolute -bottom-6 -left-6 rounded-2xl bg-white shadow-xl border border-line-200 p-4 gap-3 items-center">
        <span class="grid size-10 place-items-center rounded-xl bg-navy-900 text-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg></span>
        <div class="text-sm leading-tight">
          <div class="font-bold text-navy-900">Китай → КМВ • 12–18 дней</div>
          <div class="text-ink-500 text-xs">Гуанчжоу / Иу → Мин-Воды</div>
        </div>
      </div>
    </div>
  </div>
</section>
