---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
---

<section class="py-16 lg:py-24 bg-white">
  <div class="container-premium">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-navy-900 text-white px-3 py-1 text-xs font-bold tracking-wide uppercase">{t('testimonials.eyebrow')}</div>
      <h2 class="mt-3 font-display font-extrabold text-[30px] lg:text-[42px] leading-[0.95] text-navy-900">{t('testimonials.title')}</h2>
    </div>

    <div class="mt-10 grid lg:grid-cols-3 gap-5 lg:gap-6">
      {[0,1,2].map(i => (
        <figure class="rounded-[24px] bg-surface-50 border border-line-200 p-6 lg:p-7 flex flex-col">
          <div class="flex items-center gap-1 text-amber-500" aria-label="5 stars">
            {Array.from({length:5}).map(()=> <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>)}
            <span class="ml-2 text-xs font-bold text-navy-900">5.0</span>
          </div>
          <blockquote class="mt-4 text-[15px] leading-relaxed text-ink-700 flex-1">{t(`testimonials.items.${i}.text` as any)}</blockquote>
          <figcaption class="mt-6 flex items-center gap-3 pt-4 border-t border-line-200">
            <span class="grid size-10 place-items-center rounded-full bg-navy-900 text-white font-bold text-sm">{['МК','РМ','ДС'][i]}</span>
            <span class="text-sm font-medium text-navy-900">{t(`testimonials.items.${i}.author` as any)}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- trust badges -->
    <div class="mt-10 rounded-[24px] bg-navy-900 text-white p-6 lg:p-8">
      <div class="grid lg:grid-cols-4 gap-6 text-sm">
        <div class="flex gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white/10 border border-white/15 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
          <div><div class="font-bold">Договор</div><div class="text-white/70 text-xs">Фиксируем сроки и стоимость</div></div>
        </div>
        <div class="flex gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white/10 border border-white/15 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M16 8l-8 8"/><path d="M8 8l8 8"/></svg></span>
          <div><div class="font-bold">Страховка</div><div class="text-white/70 text-xs">До 5 млн ₽, выплата 5 дней</div></div>
        </div>
        <div class="flex gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white/10 border border-white/15 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></span>
          <div><div class="font-bold">GPS-трекинг</div><div class="text-white/70 text-xs">Ежедневный фото-отчёт</div></div>
        </div>
        <div class="flex gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white/10 border border-white/15 shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="M9 15l3 3 3-3"/></svg></span>
          <div><div class="font-bold">Документы</div><div class="text-white/70 text-xs">УПД, сертификаты для WB</div></div>
        </div>
      </div>
    </div>
  </div>
</section>
