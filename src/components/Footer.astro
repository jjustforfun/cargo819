---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-white border-t border-white/10">
  <div class="container-premium py-12 lg:py-16">
    <div class="grid lg:grid-cols-[1.4fr_0.8fr_0.8fr_1fr] gap-10">
      <!-- Brand -->
      <div>
        <a href={lang==='ru' ? '/' : '/en/'} class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white text-navy-950 font-extrabold">819</span>
          <span class="font-display font-extrabold text-xl tracking-tight">CARGO 819</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/70 max-w-[36ch]">{t('footer.brand_desc')}</p>
        <div class="mt-6 flex gap-2">
          <a href="https://t.me/cargo819" target="_blank" rel="noopener" aria-label="Telegram" class="grid size-10 place-items-center rounded-full bg-white/10 border border-white/10 hover:bg-white hover:text-navy-900 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </a>
          <a href="https://wa.me/79650693173" target="_blank" rel="noopener" aria-label="WhatsApp" class="grid size-10 place-items-center rounded-full bg-white/10 border border-white/10 hover:bg-white hover:text-navy-900 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12a8 8 0 0 1-11.7 7l-3.3 1 1-3.2A8 8 0 1 1 20 12z"/><path d="M9 11l2 2 4-4"/></svg>
          </a>
          <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram" class="grid size-10 place-items-center rounded-full bg-white/10 border border-white/10 hover:bg-white hover:text-navy-900 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
          </a>
          <a href="tel:+79650693173" aria-label="Phone" class="hidden sm:grid size-10 place-items-center rounded-full bg-accent-500 text-white hover:bg-accent-600 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L8 10a16 16 0 0 0 6 6l1.5-1a2 2 0 0 1 1.8-.6l3 .5A2 2 0 0 1 22 16.9z"/></svg>
          </a>
        </div>
        <div class="mt-6 rounded-2xl bg-white/5 border border-white/10 p-4">
          <div class="text-xs font-bold tracking-wide uppercase text-white/60">{lang==='ru' ? 'Реквизиты по запросу' : 'Details on request'}</div>
          <div class="mt-2 text-xs leading-relaxed text-white/60">{lang==='ru' ? 'Работаем с НДС • Договор • Счёт-фактура • УПД для маркетплейсов' : 'VAT • Contract • Invoice • Docs for marketplaces'}</div>
        </div>
      </div>

      <!-- Nav -->
      <div>
        <div class="text-sm font-bold tracking-wide uppercase text-white/80">{t('footer.quick')}</div>
        <ul class="mt-4 grid gap-2.5 text-sm text-white/70">
          <li><a href={lang==='ru' ? '#about' : '/en#about'} class="hover:text-white transition-colors">{t('footer.links.about')}</a></li>
          <li><a href={lang==='ru' ? '#service' : '/en#service'} class="hover:text-white transition-colors">{t('footer.links.services')}</a></li>
          <li><a href={lang==='ru' ? '#cases' : '/en#cases'} class="hover:text-white transition-colors">{t('footer.links.cases')}</a></li>
          <li><a href={lang==='ru' ? '#faq' : '/en#faq'} class="hover:text-white transition-colors">{t('footer.links.faq')}</a></li>
          <li><a href={lang==='ru' ? '#contacts' : '/en#contacts'} class="hover:text-white transition-colors">{t('footer.links.contacts')}</a></li>
        </ul>
      </div>

      <div>
        <div class="text-sm font-bold tracking-wide uppercase text-white/80">{t('footer.services')}</div>
        <ul class="mt-4 grid gap-2.5 text-sm text-white/70">
          <li>• {lang==='ru' ? 'Автоперевозки FTL/LTL' : 'Road FTL/LTL'}</li>
          <li>• {lang==='ru' ? 'Ж/Д перевозки' : 'Rail freight'}</li>
          <li>• {lang==='ru' ? 'Экспресс 5–8 дней' : 'Express 5–8 days'}</li>
          <li>• {lang==='ru' ? 'Склады Китай/КМВ' : 'Warehouses China/KMV'}</li>
          <li>• {lang==='ru' ? 'Таможня под ключ' : 'Customs turnkey'}</li>
        </ul>
      </div>

      <div id="privacy">
        <div class="text-sm font-bold tracking-wide uppercase text-white/80">{t('footer.legal')}</div>
        <ul class="mt-4 grid gap-2.5 text-sm text-white/70">
          <li><a href="#" class="hover:text-white transition-colors">{t('footer.links.tracking')}</a></li>
          <li><a href="#" class="hover:text-white transition-colors">{t('footer.links.privacy')}</a></li>
          <li><a href="#" class="hover:text-white transition-colors">{t('footer.links.terms')}</a></li>
          <li class="mt-2 text-xs leading-relaxed text-white/50">
            {lang==='ru'
              ? 'КМВ: Пятигорск, Кисловодск, Мин-Воды, Ессентуки, Железноводск, Георгиевск. Доставка по РФ и СНГ.'
              : 'KMV: Pyatigorsk, Kislovodsk, Min-Vody, Essentuki. Delivery across Russia & CIS.'}
          </li>
        </ul>
        <!-- Newsletter mini -->
        <form class="mt-6 flex gap-2" data-newsletter novalidate>
          <label class="sr-only" for="newsletter-email">{t('newsletter.placeholder')}</label>
          <input id="newsletter-email" type="email" required placeholder={t('newsletter.placeholder')} class="flex-1 min-w-0 rounded-full bg-white/10 border border-white/15 px-4 py-2.5 text-sm placeholder:text-white/50 focus:bg-white focus:text-navy-900 focus:outline-none" />
          <button type="submit" class="rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold px-5 py-2.5 text-sm transition-colors">{t('newsletter.btn')}</button>
        </form>
        <p class="hidden mt-2 text-xs text-emerald-300" data-newsletter-success>✓ {lang==='ru' ? 'Подписка оформлена' : 'Subscribed'}</p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 text-xs text-white/60">
      <div>
        {t('footer.copy').replace('2026', String(year))}
        <span class="hidden sm:inline"> • </span>
        <span>{t('footer.made')}</span>
      </div>
      <div class="flex flex-wrap gap-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/5 border border-white/10 px-3 py-1"><span class="size-2 rounded-full bg-emerald-400"></span>{lang==='ru' ? 'Сайт защищён TLS' : 'Site secured with TLS'}</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/5 border border-white/10 px-3 py-1">OWASP 2026 • CSP • HSTS</span>
      </div>
    </div>

    <!-- GEO microcopy for SEO -->
    <div class="mt-6 text-[11px] leading-relaxed text-white/35 max-w-none">
      {lang==='ru'
        ? 'Грузоперевозки из Китая в Пятигорск, Кисловодск, Минеральные Воды, Ессентуки, Железноводск, Георгиевск, Лермонтов, Ставропольский край. Логистика КМВ — CARGO 819: автодоставка, железнодорожные перевозки, экспресс, ответственное хранение, таможенное оформление, страхование. Склады в Гуанчжоу, Иу и Минеральных Водах. Доставляем в Москву, Краснодар, Ростов-на-Дону и по всей России.'
        : 'Freight from China to Pyatigorsk, Kislovodsk, Mineralnye Vody, Essentuki, Zheleznovodsk, Georgievsk. KMV logistics — CARGO 819: road, rail, express, warehousing, customs, insurance. Warehouses in Guangzhou, Yiwu & Mineralnye Vody. Delivery to Moscow, Krasnodar, Rostov and across Russia.'}
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector('[data-newsletter]') as HTMLFormElement | null;
  if (form) {
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    const success = document.querySelector('[data-newsletter-success]') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = input.value.trim();
      const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
      if (!ok) { input.classList.add('border-red-400'); return; }
      input.classList.remove('border-red-400');
      // simulate
      await new Promise(r=>setTimeout(r,600));
      success.classList.remove('hidden');
      form.reset();
      setTimeout(()=> success.classList.add('hidden'), 3000);
    });
  }
</script>
