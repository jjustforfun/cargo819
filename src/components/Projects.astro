---
import { ui } from '../i18n/ui';
type Lang = 'ru'|'en';
const { lang } = Astro.props as { lang: Lang };
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
const images = ['project-1.jpg','project-2.jpg','project-3.jpg','project-4.jpg','project-5.jpg','project-6.jpg'];
---

<section id="cases" class="py-16 lg:py-24 bg-surface-50 border-y border-line-200">
  <div class="container-premium">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-white border border-line-200 px-3 py-1 text-xs font-bold tracking-wide uppercase text-navy-900">{t('projects.eyebrow')}</div>
        <h2 class="mt-3 font-display font-extrabold text-[30px] lg:text-[42px] leading-[0.95] text-navy-900">{t('projects.title')}</h2>
        <p class="mt-3 text-ink-700">{t('projects.subtitle')}</p>
      </div>
      <a href="#contacts" class="hidden lg:inline-flex items-center gap-2 rounded-full bg-navy-900 hover:bg-navy-800 text-white font-bold px-6 py-3 transition-colors">
        {lang==='ru' ? 'Хочу так же →' : 'Want same →'}
      </a>
    </div>

    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {images.map((img, i) => (
        <article class="group overflow-hidden rounded-[24px] bg-white border border-line-200 hover:shadow-xl hover:shadow-navy-900/5 hover:-translate-y-1 transition-all">
          <div class="relative aspect-[4/3] overflow-hidden bg-surface-50">
            <img src={`/images/${img}`} alt={t(`projects.items.${i}.title` as any)} width="640" height="480" class="h-full w-full object-cover group-hover:scale-[1.04] transition-transform duration-700" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/70 via-transparent to-transparent opacity-80"></div>
            <span class="absolute top-3 left-3 rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-bold tracking-wide">{t(`projects.items.${i}.tag` as any)}</span>
            <span class="absolute bottom-3 left-3 right-3 text-white font-semibold leading-tight text-[15px] drop-shadow">{t(`projects.items.${i}.title` as any)}</span>
          </div>
          <div class="p-5 flex items-center justify-between">
            <span class="text-sm text-ink-500">{lang==='ru' ? 'Фото: наш склад' : 'Photo: our warehouse'}</span>
            <a href="#contacts" class="inline-flex items-center gap-1 text-sm font-bold text-navy-900 group-hover:text-accent-600">{t('projects.more')} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
