---
import { ui } from '../i18n/ui';
type Lang = 'ru' | 'en';
interface Props { lang: Lang; }
const { lang } = Astro.props as Props;
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
const otherLang = lang === 'ru' ? 'en' : 'ru';
const switchHref = lang === 'ru' ? '/en/' : '/';
const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 transition-colors duration-300" data-header>
  <div class="absolute inset-0 bg-navy-900/80 backdrop-blur-xl border-b border-white/10 opacity-0 transition-opacity" data-header-bg aria-hidden="true"></div>
  <div class="relative">
    <!-- Top bar for trust (desktop only) -->
    <div class="hidden lg:block border-b border-white/10 bg-white/[0.04]">
      <div class="container-premium flex items-center justify-between py-2 text-xs text-white/70">
        <div class="flex items-center gap-6">
          <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"></span>{lang==='ru' ? 'Офис открыт: Пн–Сб 9:00–19:00 • Мин-Воды, Советская 32' : 'Office open: Mon–Sat 9am–7pm • Min-Vody, Sovetskaya 32'}</span>
          <span class="hidden xl:inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg>{lang==='ru' ? 'Пятигорск • Кисловодск • Ессентуки • Железноводск' : 'Pyatigorsk • Kislovodsk • Essentuki'}</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="mailto:info@cargo819.ru" class="hover:text-white transition-colors">info@cargo819.ru</a>
          <span class="opacity-30">|</span>
          <span>{lang==='ru' ? 'Ежедневно 20т рейсы из Китая' : 'Daily 20t runs from China'}</span>
        </div>
      </div>
    </div>

    <div class="container-premium">
      <div class="flex items-center justify-between gap-4 py-3 lg:py-4">
        <!-- Logo -->
        <a href={lang==='ru' ? '/' : '/en/'} class="group flex items-center gap-3 shrink-0" aria-label="CARGO 819 — на главную">
          <span class="grid size-10 place-items-center rounded-xl bg-white text-navy-900 font-extrabold tracking-tighter leading-none text-[13px]">819</span>
          <span class="flex flex-col leading-none">
            <span class="font-display font-extrabold text-white text-[20px] tracking-tight">CARGO 819</span>
            <span class="text-[10px] tracking-[0.18em] font-semibold text-white/70 uppercase -mt-0.5">Logistics • Since 2004</span>
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden lg:flex items-center gap-1 bg-white/10 backdrop-blur rounded-full p-1 border border-white/15" aria-label={lang==='ru' ? 'Главное меню' : 'Main menu'}>
          <a href={lang==='ru'? '#about' : '/en#about'} class="px-4 py-2 rounded-full text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">{t('nav.about')}</a>
          <a href={lang==='ru'? '#service' : '/en#service'} class="px-4 py-2 rounded-full text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">{t('nav.services')}</a>
          <a href={lang==='ru'? '#process' : '/en#process'} class="px-4 py-2 rounded-full text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">{t('nav.process')}</a>
          <a href={lang==='ru'? '#cases' : '/en#cases'} class="px-4 py-2 rounded-full text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">{t('nav.cases')}</a>
          <a href={lang==='ru'? '#contacts' : '/en#contacts'} class="px-4 py-2 rounded-full text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors">{t('nav.contacts')}</a>
        </nav>

        <!-- Right -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Lang switcher -->
          <div class="hidden sm:flex items-center rounded-full bg-white/10 border border-white/15 p-1 text-xs font-semibold">
            <a href="/" aria-current={lang==='ru' ? 'page' : undefined} class={`px-3 py-1.5 rounded-full transition-colors ${lang==='ru' ? 'bg-white text-navy-900 shadow' : 'text-white/80 hover:text-white'}`}>RU</a>
            <a href="/en/" aria-current={lang==='en' ? 'page' : undefined} class={`px-3 py-1.5 rounded-full transition-colors ${lang==='en' ? 'bg-white text-navy-900 shadow' : 'text-white/80 hover:text-white'}`}>EN</a>
          </div>

          <a href="tel:+79650693173" class="hidden md:inline-flex items-center gap-3 pl-3 pr-1 py-1 rounded-full bg-white text-navy-900 font-semibold shadow-lg shadow-black/20 hover:bg-zinc-50 transition-colors">
            <span class="hidden xl:inline text-sm">+7 965 069-31-73</span>
            <span class="xl:hidden text-sm">Позвонить</span>
            <span class="grid size-8 place-items-center rounded-full bg-accent-500 text-white">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L8 10a16 16 0 0 0 6 6l1.5-1a2 2 0 0 1 1.8-.6l3 .5A2 2 0 0 1 22 16.9z"/></svg>
            </span>
          </a>

          <a href={lang==='ru' ? '#contacts' : '/en#contacts'} class="hidden sm:inline-flex items-center gap-2 rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold px-5 py-3 text-sm shadow-lg shadow-accent-500/25 transition-colors">
            {t('nav.cta')}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
          </a>

          <!-- Mobile menu btn -->
          <button
            type="button"
            class="lg:hidden grid size-11 place-items-center rounded-full bg-white/10 border border-white/15 text-white hover:bg-white/15 transition-colors"
            aria-label={lang==='ru' ? 'Открыть меню' : 'Open menu'}
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-nav-toggler
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="menu-icon"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="close-icon hidden"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="lg:hidden hidden container-premium pb-4" data-mobile-nav>
    <div class="rounded-[24px] bg-white shadow-2xl shadow-navy-900/20 border border-line-200 overflow-hidden">
      <nav class="grid p-2 gap-1" aria-label="Mobile">
        <a href={lang==='ru'? '#about':'/en#about'} class="px-4 py-3 rounded-xl hover:bg-surface-50 font-medium flex justify-between items-center" data-nav-link>{t('nav.about')} <span aria-hidden="true">›</span></a>
        <a href={lang==='ru'? '#service':'/en#service'} class="px-4 py-3 rounded-xl hover:bg-surface-50 font-medium flex justify-between items-center" data-nav-link>{t('nav.services')} <span aria-hidden="true">›</span></a>
        <a href={lang==='ru'? '#process':'/en#process'} class="px-4 py-3 rounded-xl hover:bg-surface-50 font-medium flex justify-between items-center" data-nav-link>{t('nav.process')} <span aria-hidden="true">›</span></a>
        <a href={lang==='ru'? '#cases':'/en#cases'} class="px-4 py-3 rounded-xl hover:bg-surface-50 font-medium flex justify-between items-center" data-nav-link>{t('nav.cases')} <span aria-hidden="true">›</span></a>
        <a href={lang==='ru'? '#contacts':'/en#contacts'} class="px-4 py-3 rounded-xl hover:bg-surface-50 font-medium flex justify-between items-center" data-nav-link>{t('nav.contacts')} <span aria-hidden="true">›</span></a>
        <div class="flex gap-2 pt-2">
          <a href="tel:+79650693173" class="flex-1 inline-flex justify-center items-center gap-2 rounded-full bg-navy-900 text-white font-semibold py-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L8 10a16 16 0 0 0 6 6l1.5-1a2 2 0 0 1 1.8-.6l3 .5A2 2 0 0 1 22 16.9z"/></svg>
            +7 965 069-31-73
          </a>
          <a href={switchHref} class="grid place-items-center size-12 rounded-full border border-line-200 font-bold">{otherLang.toUpperCase()}</a>
        </div>
        <a href={lang==='ru' ? '#contacts' : '/en#contacts'} class="mt-1 inline-flex justify-center items-center gap-2 rounded-full bg-accent-500 text-white font-bold py-3" data-nav-link>{t('nav.cta')} →</a>
      </nav>
      <div class="px-5 py-4 bg-surface-50 border-t border-line-200 text-xs text-ink-500">
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span>info@cargo819.ru</span><span>•</span><span>Минеральные Воды, Советская 32</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  const headerBg = document.querySelector('[data-header-bg]') as HTMLElement | null;
  const toggler = document.querySelector('[data-nav-toggler]') as HTMLButtonElement | null;
  const mobileNav = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
  const links = document.querySelectorAll('[data-nav-link]');

  function onScroll() {
    if (!header || !headerBg) return;
    if (window.scrollY > 20) {
      headerBg.classList.remove('opacity-0');
      headerBg.classList.add('opacity-100');
    } else {
      headerBg.classList.add('opacity-0');
      headerBg.classList.remove('opacity-100');
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function setExpanded(expanded: boolean) {
    if (!toggler || !mobileNav) return;
    toggler.setAttribute('aria-expanded', String(expanded));
    mobileNav.classList.toggle('hidden', !expanded);
    const menuIcon = toggler.querySelector('.menu-icon');
    const closeIcon = toggler.querySelector('.close-icon');
    menuIcon?.classList.toggle('hidden', expanded);
    closeIcon?.classList.toggle('hidden', !expanded);
    document.body.style.overflow = expanded ? 'hidden' : '';
  }

  toggler?.addEventListener('click', () => {
    const isExpanded = toggler.getAttribute('aria-expanded') === 'true';
    setExpanded(!isExpanded);
  });
  links.forEach(a => a.addEventListener('click', () => setExpanded(false)));
  document.addEventListener('keydown', (e) => { if (e.key==='Escape') setExpanded(false); });
  // Close on resize to desktop
  window.addEventListener('resize', () => { if (window.innerWidth >= 1024) setExpanded(false); });
</script>
