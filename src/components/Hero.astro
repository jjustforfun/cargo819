---
import { ui } from '../i18n/ui';
type Lang = 'ru' | 'en';
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const t = (k: keyof typeof ui['ru']) => (ui[lang] as any)[k] ?? ui['ru'][k];
const videoSrc = '/video-hero.mp4';
// Cloudfront fallback if local fails is same video, we use local for reliability
---

<section id="home" class="relative isolate overflow-hidden bg-navy-950">
  <!-- Video background -->
  <div class="absolute inset-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-banner.jpg"
      class="h-full w-full object-cover"
      aria-label={t('hero.video_alt')}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
    <!-- Premium gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950/70 via-navy-900/55 to-navy-950/90"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/60 via-transparent to-transparent"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
  </div>

  <!-- Content -->
  <div class="relative container-premium pt-32 pb-12 lg:pt-40 lg:pb-20">
    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-8 items-start">
      <!-- Left -->
      <div class="max-w-[720px]">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur border border-white/15 px-3 py-1.5 text-xs font-semibold tracking-wide text-white/90">
          <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.9)] animate-pulse" aria-hidden="true"></span>
          {t('hero.eyebrow')}
          <span class="hidden sm:inline-flex items-center gap-1.5 ml-2 pl-2 border-l border-white/20">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
            4.9/5 на Яндекс
          </span>
        </div>

        <h1 class="mt-6 font-display font-extrabold text-white text-[35px] sm:text-[48px] lg:text-[62px] leading-[0.95] tracking-tight text-balance">
          <span class="block text-white/90 font-semibold text-[18px] lg:text-[20px] tracking-[0.14em] uppercase mb-3">{lang==='ru' ? 'Во всех направлениях' : 'In every direction'}</span>
          <span class="block">{t('hero.title1')}</span>
          <span class="block text-accent-500">{t('hero.title2')}</span>
        </h1>

        <p class="mt-5 text-[16px] lg:text-[18px] leading-relaxed text-white/80 max-w-[60ch] text-balance" set:html={t('hero.subtitle')} />

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="#contacts" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold px-7 py-4 text-[16px] shadow-xl shadow-accent-500/25 transition-colors focus-visible:outline-white">
            {t('hero.cta_primary')}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#service" class="inline-flex items-center justify-center gap-2 rounded-full bg-white/10 hover:bg-white/15 backdrop-blur border border-white/20 text-white font-semibold px-7 py-4 transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            {t('hero.cta_secondary')}
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs font-medium text-white/70">
          <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{lang==='ru' ? 'Договор + страховка' : 'Contract + insurance'}</span>
          <span class="size-1 rounded-full bg-white/30"></span>
          <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{lang==='ru' ? 'Свой склад в Китае' : 'Own warehouse in China'}</span>
          <span class="size-1 rounded-full bg-white/30"></span>
          <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{lang==='ru' ? 'Без предоплаты 100%' : 'No 100% prepay'}</span>
        </div>

        <!-- Stats -->
        <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          { [0,1,2,3].map(i => (
            <div class="rounded-2xl bg-white/10 backdrop-blur border border-white/10 p-4">
              <div class="font-display font-extrabold text-white text-[24px] leading-none">{t(`hero.stats.${i}.value` as any)}</div>
              <div class="mt-1 text-xs leading-tight text-white/70">{t(`hero.stats.${i}.label` as any)}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: quick quote card -->
      <div class="lg:sticky lg:top-28">
        <div class="rounded-[28px] bg-white shadow-[0_24px_64px_rgba(5,14,31,0.35)] border border-line-200 overflow-hidden">
          <div class="bg-navy-900 px-6 py-5 text-white flex items-center justify-between">
            <div>
              <div class="font-display font-bold text-[18px] leading-none">{t('hero.form.title')}</div>
              <div class="text-xs text-white/70 mt-1">{t('hero.form.subtitle')}</div>
            </div>
            <div class="hidden sm:grid size-10 place-items-center rounded-full bg-white/10 border border-white/15">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
          </div>

          <form class="p-6 grid gap-4" id="hero-quote" novalidate data-hero-form>
            <!-- honeypot -->
            <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div class="grid sm:grid-cols-2 gap-4">
              <label class="grid gap-1.5">
                <span class="text-xs font-semibold tracking-wide uppercase text-ink-500">{t('hero.form.from')}</span>
                <input required name="from" placeholder={lang==='ru'? 'Гуанчжоу, Иу...' : 'Guangzhou, Yiwu...'} class="w-full rounded-xl border border-line-200 bg-surface-50 px-4 py-3 text-sm focus:bg-white focus:border-navy-900 focus:outline-none transition-colors" />
              </label>
              <label class="grid gap-1.5">
                <span class="text-xs font-semibold tracking-wide uppercase text-ink-500">{t('hero.form.to')}</span>
                <select name="to" class="w-full rounded-xl border border-line-200 bg-surface-50 px-4 py-3 text-sm focus:bg-white focus:border-navy-900 focus:outline-none">
                  <option value="Пятигорск">Пятигорск</option>
                  <option value="Кисловодск">Кисловодск</option>
                  <option value="Минеральные Воды">Минеральные Воды</option>
                  <option value="Ессентуки">Ессентуки</option>
                  <option value="Железноводск">Железноводск</option>
                  <option value="Георгиевск">Георгиевск</option>
                  <option value="Ставрополь">Ставрополь</option>
                  <option value="Москва">Москва</option>
                  <option value="Краснодар">Краснодар</option>
                </select>
              </label>
            </div>

            <label class="grid gap-1.5">
              <span class="text-xs font-semibold tracking-wide uppercase text-ink-500">{t('hero.form.weight')}</span>
              <input name="weight" placeholder={lang==='ru'? 'напр. 420 кг / 2.1 м³, текстиль' : 'e.g. 420 kg / 2.1 cbm, textile'} class="w-full rounded-xl border border-line-200 bg-surface-50 px-4 py-3 text-sm focus:bg-white focus:border-navy-900 focus:outline-none" />
            </label>

            <label class="grid gap-1.5">
              <span class="text-xs font-semibold tracking-wide uppercase text-ink-500">{t('hero.form.phone')} <span class="text-red-500">*</span></span>
              <input required type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+7 900 000-00-00" pattern="^\\+?[0-9\\s\\-\\(\\)]{10,}$" class="w-full rounded-xl border border-line-200 bg-surface-50 px-4 py-3 text-sm focus:bg-white focus:border-navy-900 focus:outline-none" />
              <span class="hidden text-xs text-red-600" data-error-phone>{lang==='ru' ? 'Укажите корректный телефон' : 'Enter valid phone'}</span>
            </label>

            <button type="submit" class="mt-1 inline-flex items-center justify-center gap-2 rounded-full bg-accent-500 hover:bg-accent-600 text-white font-bold py-4 shadow-lg shadow-accent-500/20 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
              <span data-submit-label>{t('hero.form.submit')}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4L12 14.1l-3-3"/></svg>
            </button>

            <p class="text-center text-[11px] leading-relaxed text-ink-500" set:html={t('hero.form.privacy')} />
            <p class="hidden rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm px-4 py-3" data-success role="status" aria-live="polite">
              ✓ {lang==='ru' ? 'Заявка отправлена! Перезвоним за 15 минут.' : 'Sent! We’ll call within 15 min.'}
            </p>
            <p class="hidden rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm px-4 py-3" data-error role="alert"></p>
          </form>

          <div class="px-6 pb-6 flex items-center justify-between text-xs text-ink-500 border-t border-line-200 pt-4 mx-6">
            <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-500"></span>{lang==='ru' ? 'Менеджер онлайн' : 'Manager online'}</span>
            <span>{lang==='ru' ? 'Отвечаем за 7 минут' : 'Reply in 7 min'}</span>
          </div>
        </div>

        <div class="mt-4 rounded-2xl bg-white/10 backdrop-blur border border-white/15 p-4 flex items-center gap-3 text-white/90">
          <img src="/images/about-banner.jpg" alt="" width="48" height="48" class="size-12 rounded-xl object-cover shrink-0" loading="lazy" decoding="async" />
          <div class="text-sm leading-tight">
            <div class="font-semibold text-white">{lang==='ru' ? 'Артём, логист КМВ' : 'Artyom, KMV logistician'} • <span class="text-emerald-300">● онлайн</span></div>
            <div class="text-white/70 text-xs">«{lang==='ru' ? 'Считаю честно, показываю все статьи. Без сюрпризов.' : 'I calculate honestly, show all items. No surprises.'}»</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom trust line -->
    <div class="mt-10 flex flex-wrap items-center gap-3 text-xs sm:text-sm text-white/70">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1.5 backdrop-blur" set:html={t('hero.trust_line')} />
      <span class="hidden sm:inline-flex items-center gap-2">• {lang==='ru' ? 'Работаем с НДС и без' : 'With and without VAT'}</span>
      <span class="hidden sm:inline-flex items-center gap-2">• {lang==='ru' ? 'Документы для WB/Ozon' : 'Docs for marketplaces'}</span>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
</section>

<script>
  // Lightweight client validation + fake submit (no backend yet) — OWASP: honeypot + rate limit via localStorage
  const form = document.querySelector('[data-hero-form]') as HTMLFormElement | null;
  if (form) {
    const phone = form.querySelector('input[name="phone"]') as HTMLInputElement;
    const phoneErr = form.querySelector('[data-error-phone]') as HTMLElement;
    const success = form.querySelector('[data-success]') as HTMLElement;
    const error = form.querySelector('[data-error]') as HTMLElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = form.querySelector('[data-submit-label]') as HTMLElement;

    function validPhone(v: string) {
      const digits = v.replace(/\D/g, '');
      return digits.length >= 10 && digits.length <= 15;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.add('hidden');
      success.classList.add('hidden');

      // honeypot
      const hp = (form.querySelector('input[name="company"]') as HTMLInputElement)?.value;
      if (hp) return; // bot

      // rate limit: 1 per 30s
      const last = Number(localStorage.getItem('cargo819_last_submit') || 0);
      if (Date.now() - last < 30000) {
        error.textContent = form.lang === 'en' ? 'Please wait 30 seconds before next request.' : 'Подождите 30 секунд перед следующей заявкой.';
        error.classList.remove('hidden');
        return;
      }

      let ok = true;
      if (!phone || !validPhone(phone.value)) {
        ok = false;
        phone?.classList.add('border-red-400', 'bg-red-50');
        phoneErr?.classList.remove('hidden');
      } else {
        phone?.classList.remove('border-red-400', 'bg-red-50');
        phoneErr?.classList.add('hidden');
      }

      // check required
      const required = form.querySelectorAll('[required]');
      required.forEach(el => {
        const i = el as HTMLInputElement;
        if (!i.value.trim()) { ok = false; i.classList.add('border-red-400'); }
        else i.classList.remove('border-red-400');
      });

      if (!ok) {
        error.textContent = document.documentElement.lang === 'en' ? 'Please fill highlighted fields correctly.' : 'Проверьте подсвеченные поля.';
        error.classList.remove('hidden');
        return;
      }

      const orig = label.textContent;
      btn.disabled = true;
      label.textContent = document.documentElement.lang === 'en' ? 'Sending...' : 'Отправляем...';

      // Simulate network — in production POST to /api/contact with CSRF + Zod
      await new Promise(r => setTimeout(r, 900));

      // Success: in real app would be fetch('/api/contact', {method:'POST', body: JSON.stringify(...)})
      localStorage.setItem('cargo819_last_submit', String(Date.now()));
      form.reset();
      success.classList.remove('hidden');
      btn.disabled = false;
      if (orig) label.textContent = orig;

      // Analytics event placeholder (privacy friendly)
      try { (window as any).gtag?.('event','generate_lead', {source:'hero'}); } catch {}
    });

    phone?.addEventListener('input', () => {
      phone.classList.remove('border-red-400','bg-red-50');
      phoneErr?.classList.add('hidden');
    });
  }
</script>
