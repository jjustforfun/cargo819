---
import Layout from '../layouts/Layout.astro';
const lang = 'ru' as const;
---

<Layout title="404 — Страница не найдена | CARGO 819" description="Страница не найдена. Вернитесь на главную CARGO 819." lang={lang} canonical="https://cargo819.ru/404">
  <main class="min-h-[70vh] grid place-items-center bg-surface-50">
    <div class="text-center p-8">
      <div class="inline-flex items-center gap-2 rounded-full bg-white border border-line-200 px-3 py-1 text-xs font-bold tracking-wide uppercase text-navy-900">Ошибка 404</div>
      <h1 class="mt-4 font-display font-extrabold text-4xl lg:text-5xl text-navy-900">Страница не найдена</h1>
      <p class="mt-3 text-ink-700">Похоже, вы попали не туда. Давайте вернём вас на маршрут.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-full bg-navy-900 text-white font-bold px-6 py-3">На главную →</a>
        <a href="tel:+79650693173" class="inline-flex items-center gap-2 rounded-full border border-line-200 bg-white px-6 py-3 font-semibold">Позвонить</a>
      </div>
    </div>
  </main>
</Layout>
